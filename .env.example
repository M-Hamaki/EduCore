# =====================================================
# EduCore Environment Configuration — Template
# =====================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# Copy this file to .env and modify values for your environment
# =====================================================

# =====================================================
# Application Environment / بيئة التطبيق
# =====================================================
# production = إخفاء الأخطاء وتسجيلها فقط (الإنتاج)
# development = عرض كل الأخطاء (التطوير المحلي)
APP_ENV=development

# Staff HR rollout: off | shadow | compare | display | official
# display exposes the reviewed new surfaces while keeping legacy fallback.
STAFF_HR_MODE=off

# Session security / إعدادات الجلسة
SESSION_COOKIE_LIFETIME=0
SESSION_MAX_LIFETIME=86400
SESSION_REGENERATE_INTERVAL=1800
SESSION_IDLE_TIMEOUT=3600
ADMIN_SESSION_IDLE_TIMEOUT=1800
SESSION_SAMESITE=Lax

# =====================================================
# Database / قاعدة البيانات
# =====================================================
DB_HOST=localhost
DB_NAME=educore
DB_USERNAME=root
DB_PASSWORD=

# Required only for tests that may write or initialize schema. Must end in _test.
EDUCORE_TEST_DB_NAME=educore_test

# Application URL / رابط التطبيق دون شرطة مائلة أخيرة
APP_URL=http://localhost/EduCore
# Legacy compatibility; APP_URL takes precedence when both are set.
SITE_URL=http://localhost/EduCore

# Deployment identity / هوية الجهة المشغلة
ORGANIZATION_NAME=Example School
SUPPORT_EMAIL=admin@example.com
SUPPORT_PHONE=
# Optional URL for an external results portal. Leave empty when unused.
RESULTS_PORTAL_URL=

# Optional initial administrator to promote to super_admin during bootstrap.
# Leave empty for normal installations.
INITIAL_SUPER_ADMIN_USERNAME=

# =====================================================
# Timezone / المنطقة الزمنية
# =====================================================
# المنطقة الزمنية الافتراضية للنظام. تُطبَّق وقت تحميل البوابة (config/database.php)
# لضمان اتساق الطوابع الزمنية حتى لو كانت date.timezone في php.ini غير مضبوطة.
# القيمة الافتراضية: Africa/Cairo. استخدم معرّفات PHP timezone الصحيحة.
# Examples: Africa/Cairo, Asia/Riyadh, Asia/Dubai, Asia/Kuwait
APP_TIMEZONE=Africa/Cairo

# =====================================================
# Google Gemini AI
# =====================================================
# =====================================================
# Google Gemini AI
# =====================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS_FALLBACK=key1,key2,key3

# Gemini content safety threshold
# Recommended default for educational deployments:
# BLOCK_LOW_AND_ABOVE    = strictest
# BLOCK_MEDIUM_AND_ABOVE = recommended default
# BLOCK_ONLY_HIGH        = more permissive
# BLOCK_NONE             = no probability-based blocking; not recommended for schools
GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# =====================================================
# Ollama (Local AI) / الذكاء الاصطناعي المحلي
# =====================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120
# المزوّد الافتراضي: gemini, ollama, auto
AI_DEFAULT_PROVIDER=auto

# =====================================================
# Image Search APIs / محركات بحث الصور
# =====================================================
PIXABAY_API_KEY=your_pixabay_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
PEXELS_API_KEY=your_pexels_key_here

# =====================================================
# YouTube Data API v3 / البحث في يوتيوب
# =====================================================
YOUTUBE_API_KEY=your_youtube_api_key_here
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# =====================================================
# Microsoft Azure AD / Entra ID (SSO)
# =====================================================
# auto | local | production. Use local explicitly only for a configured HTTPS development tunnel.
MICROSOFT_SSO_ENV=auto
AZURE_CLIENT_ID=your_client_id_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_REDIRECT_URI=https://school.example.com/auth/microsoft_callback.php
AZURE_TEAMS_REDIRECT_URI=https://school.example.com/auth/teams_sso.php
# Optional localhost overrides. Leave credentials empty to reuse the production registration.
AZURE_LOCAL_CLIENT_ID=
AZURE_LOCAL_TENANT_ID=
AZURE_LOCAL_CLIENT_SECRET=
AZURE_LOCAL_REDIRECT_URI=http://localhost/EduCore/auth/microsoft_callback.php
AZURE_LOCAL_TEAMS_REDIRECT_URI=http://localhost/EduCore/auth/teams_sso.php
# Optional when a separate Teams/Entra development app registration is used.
AZURE_LOCAL_TEAMS_APP_ID_URI=
TEAMS_APP_ID_URI=api://school.example.com/your_client_id_here
SSO_SESSION_TIMEOUT=86400
SSO_ALLOW_AUTO_REGISTER=false
SSO_DEBUG_MODE=false
UNIFIED_ACCESS_PORTAL_ENABLED=true
TEAMS_AUTO_SSO_ENABLED=true

# =====================================================
# Canva Connect API / تكامل Canva
# =====================================================
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=https://yourdomain.com/EduCore/admin/canva_callback.php

# =====================================================
# Encryption / التشفير
# =====================================================
ENCRYPTION_KEY_HEX=generate_a_64_char_hex_string_here
PASSWORD_KEY_VERSION=2
PASSWORD_LEGACY_LOGIN_ENABLED=true
PASSWORD_ENCRYPTION_KEY_HEX=generate_a_separate_64_char_hex_string_here
# Optional old keys while rotating: {"1":"old_hex_key","2":"new_hex_key"}
PASSWORD_ENCRYPTION_KEYS_JSON=

# =====================================================
# Finance Module / الوحدة المالية
# =====================================================
# وضع وحدة المالية: off (معطّلة) | shadow (حساب متوازي) | display (عرض مقارن) | execute (مصدر الحقيقة)
FINANCE_LEDGER_MODE=off
