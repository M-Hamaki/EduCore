Options -Indexes -ExecCGI

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .phps .cgi .pl .py .sh .asp .aspx .jsp .shtml
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .phps .cgi .pl .py .sh .asp .aspx .jsp .shtml
</IfModule>

<FilesMatch "\.(?:php[0-9]?|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
